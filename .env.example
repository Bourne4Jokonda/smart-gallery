# Cloudinary upload config (unsigned upload preset "smart-gallery" required)
VITE_CLOUDINARY_CLOUD_NAME=

# Firebase web app config (project "smart-gallery")
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=smart-gallery.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-gallery
VITE_FIREBASE_STORAGE_BUCKET=smart-gallery.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only (БЕЗ префикса VITE_) — токен Telegram-бота для /api/notify-lead.
# Задаётся вручную в Project Settings → Environment Variables.
TELEGRAM_BOT_TOKEN=
