# Скопируйте в functions/.env.local для локальной работы в эмуляторе.
# Реальные значения в репозиторий не коммитим.
# В продакшене эти же имена задаются через Secret Manager:
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN
#   firebase functions:secrets:set TELEGRAM_CHAT_ID

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
